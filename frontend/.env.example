# Copy this file to .env.local for local dev (Vite auto-loads it)
# Set the same values in Netlify -> Site configuration -> Environment variables for deployment

# Supabase -- Project Settings -> API in your Supabase dashboard
# Only the PUBLIC anon key goes here -- never the service role key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
